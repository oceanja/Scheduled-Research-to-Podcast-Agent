# ===== Supabase =====
# From Supabase project settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# From Supabase project settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here
# From Supabase project settings → Database → Connection string (use the "session" pooler on port 5432 for asyncpg)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ===== Gnani TTS =====
# From app.gnani.ai dashboard. The header name is X-API-Key-ID.
GNANI_API_KEY=your-gnani-api-key
# Voice name from the Gnani dashboard. Example defaults for en-IN below.
GNANI_VOICE=meera
GNANI_LANGUAGE=en-IN
GNANI_MODEL=timbre-v2.5

# ===== Tavily =====
# From tavily.com, free tier is 1k searches/mo
TAVILY_API_KEY=tvly-xxxxxxxx

# ===== LLM (Google Gemini) =====
# From https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.8-flash

# ===== Email (Resend) =====
RESEND_API_KEY=re_...
# For demo you can use "Daily Brief <onboarding@resend.dev>". For prod, verify your own domain.
EMAIL_FROM=Daily Brief <onboarding@resend.dev>

# ===== URLs =====
# Frontend base URL — used in emails to link to the episode page
APP_URL=http://localhost:3000
# Backend CORS allow-list (comma-separated). Set to your Vercel URL in prod.
CORS_ORIGINS=http://localhost:3000
# Backend base URL — used by the frontend to call the API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public Supabase vars for the frontend
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ===== Optional tuning =====
# Max Generate-Now runs per user per 24h (protects Gnani credit balance)
GENERATE_NOW_DAILY_LIMIT=5
